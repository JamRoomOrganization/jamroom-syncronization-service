{
  "name": "jamroom-syncronization-service",
  "version": "1.0.0",
  "description": "Backend for synchronization service",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --forceExit --detectOpenHandles",
    "test:verbose": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:single": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=",
    "start": "node src/server.js",
    "dev": "nodemon --exec \"node -r dotenv/config src/server.js\"",
    "dev:local": "nodemon --exec \"node -r dotenv/config src/server.js dotenv_config_path=.env.local\"",
    "dev:railway": "nodemon src/server.js",
    "setup:railway": "node scripts/setup-railway.js",
    "railway:logs": "railway logs",
    "railway:vars": "railway variables"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamRoomOrganization/jamroom-syncronization-service.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JamRoomOrganization/jamroom-syncronization-service/issues"
  },
  "homepage": "https://github.com/JamRoomOrganization/jamroom-syncronization-service#readme",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.2.1",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "node-cache": "^5.1.2",
    "redis": "^5.9.0",
    "redlock": "^5.0.0-beta.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "express-list-endpoints": "^7.1.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.1"
  }
}
